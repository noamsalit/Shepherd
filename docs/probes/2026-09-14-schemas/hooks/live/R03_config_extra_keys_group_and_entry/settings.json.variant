{
 "enabledPlugins": {
  "cc10x@cc10x": false
 },
 "hooks": {
  "UserPromptSubmit": [
   {
    "matcher": "*",
    "_shepherd_managed": true,
    "hooks": [
     {
      "type": "command",
      "command": "true",
      "_shepherd_managed": true,
      "timeout": 5
     }
    ]
   },
   {
    "matcher": "*",
    "hooks": [
     {
      "type": "command",
      "command": "/root/Shepherd/docs/probes/2026-09-14-schemas/hooks/capture_hook.sh UserPromptSubmit__from_settings_json /root/Shepherd/docs/probes/2026-09-14-schemas/hooks/live/R03_config_extra_keys_group_and_entry/events.jsonl"
     }
    ]
   }
  ]
 },
 "env": {
  "SHP_SETTINGS_JSON_LOADED": "1"
 }
}